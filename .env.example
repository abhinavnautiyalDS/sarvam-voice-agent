SARVAM_API_KEY=
BAKBAK_API_KEY=
BAKBAK_VOICE_ID=
HF_TOKEN=
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_STT_STREAM_TYPE=fast
SARVAM_STT_MODE=verbatim
SARVAM_STT_THRESHOLD=0.3
SARVAM_SILENCE_DURATION_MS=900
SARVAM_MIN_SPEECH_DURATION_MS=300
SARVAM_LLM_URL=https://api.sarvam.ai/v1/chat/completions
SARVAM_LLM_MAX_TOKENS=120
BAKBAK_TTS_URL=https://hub.getraya.app/v1/text-to-speech
BAKBAK_TTS_SPEED=1.0
LANGUAGE_CLASSIFIER_MODEL_URL=https://raw.githubusercontent.com/abhinavnautiyalDS/hindi-english-language-classifier/main/models/language_classifier.joblib
LANGUAGE_CLASSIFIER_MODEL_PATH=models/language_classifier.joblib
LANGUAGE_CLASSIFIER_MIN_CHARS=4
LANGUAGE_CLASSIFIER_MIN_CONFIDENCE=0.60
# Voice system prompt is loaded from system_prompt.txt. That file takes precedence.

# Recommended hosted WebRTC relay (Cloudflare Realtime TURN)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_KEY_API_TOKEN=
# Optional custom TURN server instead
TURN_SERVER_URL=
TURN_SERVER_USERNAME=
TURN_SERVER_CREDENTIAL=
