[Unit]
Description=AURA FastAPI Voice Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sarvam-voice-agent
EnvironmentFile=/home/ubuntu/sarvam-voice-agent/.env
ExecStart=/home/ubuntu/sarvam-voice-agent/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
